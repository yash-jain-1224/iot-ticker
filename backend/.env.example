# ===========================================
# IoT Ticker Platform - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://your_user@localhost:5432/iot_ticker
DATABASE_URL_SYNC=postgresql://your_user@localhost:5432/iot_ticker
DATABRICKS_SSL_MODE=disable

# Local DB convenience vars (used by standalone scripts)
DB_NAME=iot_ticker
DB_USER=your_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable

# --- Security ---
SECRET_KEY=change-me-to-a-random-256-bit-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Kafka (optional) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=iot-telemetry
KAFKA_TOPIC_EVENTS=iot-events
KAFKA_CONSUMER_GROUP=iot-ticker-backend

# --- MQTT (optional) ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Redis (optional) ---
REDIS_URL=redis://localhost:6379

# --- Databricks (production only) ---
DATABRICKS_HOST=
DATABRICKS_PORT=5432
DATABRICKS_DATABASE=
DATABRICKS_USER=
DATABRICKS_PASSWORD=
DATABRICKS_SCHEMA=
DATABRICKS_TOKEN=
DATABRICKS_DASHBOARD_BASE_URL=

# --- Runtime ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
